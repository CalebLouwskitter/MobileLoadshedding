<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Language options displayed in settings panel.
         Order matters: index is persisted to SharedPreferences for quick lookup.
         NEVER reorder this array or existing user preferences will break! -->
    <string-array name="settings_languages">
        <item>English</item>
        <item>Afrikaans</item>
        <item>isiZulu</item>
        <item>isiXhosa</item>
        <item>Sesotho</item>
    </string-array>
    
    <!-- Locale codes map 1:1 to settings_languages by index.
         These get passed to Locale constructors when user changes language.
         Empty string = default (English), rest are standard ISO 639-1 codes. -->
    <string-array name="language_codes">
        <item></item>        <!-- English (default) -->
        <item>af</item>     <!-- Afrikaans -->
        <item>zu</item>     <!-- isiZulu -->
        <item>xh</item>     <!-- isiXhosa -->
        <item>st</item>     <!-- Sesotho -->
    </string-array>
    
    <string-array name="settings_themes">
        <item>Light</item>
        <item>Dark</item>
        <item>System Default</item>
    </string-array>
</resources>
