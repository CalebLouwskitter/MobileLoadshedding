<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item android:left="0dp" android:top="@dimen/modal_panel_shadow_offset" android:right="0dp" android:bottom="0dp">
        <shape>
            <solid android:color="@color/modal_shadow_panel" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="@dimen/modal_panel_corner_radius"
                android:bottomRightRadius="@dimen/modal_panel_corner_radius" />
        </shape>
    </item>
    <!-- Main panel with flat color -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="@dimen/modal_panel_shadow_offset">
        <shape>
            <solid android:color="@color/modal_panel_red_center" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="@dimen/modal_panel_corner_radius"
                android:bottomRightRadius="@dimen/modal_panel_corner_radius" />
        </shape>
    </item>
</layer-list>