<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_rounded"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:id="@+id/header_tabs_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/modal_header_primary"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="@dimen/spacing_medium"
            android:text="Profile"
            android:textColor="@color/modal_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tab_leaderboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/modal_text_on_light"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:padding="@dimen/spacing_medium"
            android:text="Leader board"
            android:textColor="@color/modal_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/label_add_friend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_normal"
        android:layout_marginStart="@dimen/panel_padding_horizontal"
        android:text="Add Friend by Code"
        android:textColor="@color/modal_text_dark_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/header_tabs_container"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/input_friend_code"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginStart="@dimen/panel_padding_horizontal"
        android:layout_marginEnd="8dp"
        android:background="@android:drawable/edit_text"
        android:hint="K7M9-P2WX"
        android:inputType="textCapCharacters"
        android:fontFamily="monospace"
        android:minHeight="44dp"
        android:paddingStart="@dimen/spacing_medium"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_small"
        android:textSize="15sp"
        android:maxLength="9"
        app:layout_constraintTop_toBottomOf="@id/label_add_friend"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_add_friend" />

    <Button
        android:id="@+id/btn_add_friend"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/panel_padding_horizontal"
        android:backgroundTint="@color/modal_button_primary"
        android:minWidth="0dp"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:text="ADD"
        android:textColor="@color/modal_text_primary"
        android:textSize="13sp"
        app:layout_constraintTop_toTopOf="@id/input_friend_code"
        app:layout_constraintBottom_toBottomOf="@id/input_friend_code"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_add_friend_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:layout_marginStart="@dimen/panel_padding_horizontal"
        android:layout_marginEnd="@dimen/panel_padding_horizontal"
        android:text=""
        android:textColor="@color/modal_text_on_light_secondary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/input_friend_code"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Friends/Global Toggle Buttons -->
    <TextView
        android:id="@+id/btn_show_friends"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginStart="@dimen/panel_padding_horizontal"
        android:layout_marginEnd="@dimen/spacing_small"
        android:background="@drawable/bg_toggle_friends"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_medium"
        android:text="Friends"
        android:textColor="@color/modal_toggle_inactive_text"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/text_add_friend_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_show_global" />

    <TextView
        android:id="@+id/btn_show_global"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_small"
        android:layout_marginEnd="@dimen/panel_padding_horizontal"
        android:background="@drawable/bg_toggle_global"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:paddingTop="@dimen/spacing_medium"
        android:paddingBottom="@dimen/spacing_medium"
        android:text="Global"
        android:textColor="@color/modal_toggle_active_text"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="@id/btn_show_friends"
        app:layout_constraintStart_toEndOf="@id/btn_show_friends"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_friends_last_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:layout_marginStart="@dimen/panel_padding_horizontal"
        android:text="Updated --"
        android:textColor="@color/modal_text_dark_gray"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/btn_show_friends"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/friends_loading"
        style="@android:style/Widget.ProgressBar.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/text_friends_last_updated"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/text_friends_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xlarge"
        android:text="No friends yet"
        android:textColor="@color/modal_text_on_light_secondary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/text_friends_last_updated"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/friends_list_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_medium"
        android:layout_marginStart="@dimen/panel_padding_horizontal"
        android:layout_marginEnd="@dimen/panel_padding_horizontal"
        android:layout_marginBottom="@dimen/panel_padding_vertical"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/text_friends_last_updated"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
