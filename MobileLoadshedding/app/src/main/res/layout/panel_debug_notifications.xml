<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/modal_background_red"
    android:paddingStart="@dimen/panel_padding_horizontal"
    android:paddingEnd="@dimen/panel_padding_horizontal"
    android:paddingTop="@dimen/panel_padding_horizontal"
    android:paddingBottom="@dimen/panel_padding_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header row: back arrow + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/btn_back_debug"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/accessibility_close"
                android:src="@drawable/ic_arrow_back"
                app:tint="@android:color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Debug notifications"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hero Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/modal_background_red"
            app:strokeColor="@color/modal_header_primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" Notification Studio"
                    android:textColor="@color/auth_header_text"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preview exactly what players see before sending anything live."
                    android:textColor="@color/modal_text_on_accent"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use the cards below to grant permissions, refresh tokens, and simulate every state the app supports."
                        android:textColor="@color/modal_text_on_accent"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Checklist Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/modal_background_red"
            app:strokeColor="@color/modal_header_primary"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" Readiness checklist"
                    android:textColor="@color/auth_header_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/text_status_permission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/modal_header_primary"
                    android:padding="12dp"
                    android:text="Notification permission: checking..."
                    android:textColor="@color/auth_header_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/text_status_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/modal_header_primary"
                    android:padding="12dp"
                    android:text="FCM token: checking..."
                    android:textColor="@color/auth_header_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/text_status_backend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/modal_header_primary"
                    android:padding="12dp"
                    android:text="Backend sync: checking..."
                    android:textColor="@color/auth_header_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_request_notification_permission"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Grant permission"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/modal_button_secondary"
                        android:textColor="@android:color/white"
                        android:layout_marginEnd="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_force_token_refresh"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sync token"
                        android:textAllCaps="false"
                        android:backgroundTint="@color/modal_button_primary"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_notification_settings"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Open Android notification settings"
                    android:textAllCaps="false"
                    android:textColor="@color/auth_header_text"
                    android:layout_marginBottom="16dp"
                    android:backgroundTint="@android:color/transparent" />

                <TextView
                    android:id="@+id/text_last_notification_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Last simulation: --"
                    android:textColor="@color/auth_header_text"
                    android:textSize="14sp"
                    android:background="@color/modal_header_primary"
                    android:padding="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cloud Broadcast Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/modal_background_red"
            app:strokeColor="@color/modal_header_primary"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" Firebase cloud broadcast"
                    android:textColor="@color/auth_header_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Send a full round-trip test through Firebase before presenting to users."
                    android:textColor="@color/modal_text_on_accent"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_cloud_notification"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Send event started"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/modal_button_accent"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/text_cloud_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cloud status: waiting"
                    android:textColor="@color/auth_header_text"
                    android:textSize="14sp"
                    android:background="@color/modal_header_primary"
                    android:padding="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Event Notifications Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/modal_background_red"
            app:strokeColor="@color/modal_header_primary"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Event alerts"
                    android:textColor="@color/auth_header_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_event_started"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" Event started"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/modal_button_primary"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_event_ending_soon"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Event ending soon"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/modal_button_warning"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Friend Notifications Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/modal_background_red"
            app:strokeColor="@color/modal_header_primary"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👥 Friend updates"
                    android:textColor="@color/auth_header_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_friend_request"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Friend request"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/modal_button_secondary"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_friend_accepted"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=" Friend accepted"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/modal_button_primary"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- System Notifications Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/modal_background_red"
            app:strokeColor="@color/modal_header_primary"
            app:strokeWidth="0.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="System notices"
                    android:textColor="@color/auth_header_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_system_announcement"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="System announcement"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/modal_button_info"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_maintenance"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Maintenance required"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/modal_button_danger"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_test_general"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="General notification"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/modal_button_info"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Info Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simulations stay on-device and help you validate layouts, sounds, and navigation without needing staging traffic."
            android:textSize="12sp"
            android:textColor="@color/auth_header_text"
            android:textStyle="italic"
            android:gravity="center"
            android:padding="@dimen/panel_padding_horizontal"
            android:background="@color/modal_header_primary"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp" />

    </LinearLayout>
</ScrollView>
