<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/modal_tab_overlap_height"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_red"
            android:paddingStart="@dimen/panel_padding_horizontal"
            android:paddingTop="@dimen/panel_padding_top"
            android:paddingEnd="@dimen/panel_padding_horizontal"
            android:paddingBottom="@dimen/panel_padding_vertical">

            <!-- Profile Header -->
            <FrameLayout
                android:id="@+id/avatar_container"
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <View
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/circle_white" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/accessibility_profile_avatar"
                    android:src="@drawable/ic_profile_large"
                    app:tint="@color/modal_panel_red_center" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_profile_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_normal"
                android:text="Your Name"
                android:textColor="@color/modal_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/avatar_container"
                app:layout_constraintStart_toEndOf="@id/avatar_container"
                app:layout_constraintEnd_toStartOf="@id/text_profile_tag" />

            <TextView
                android:id="@+id/text_profile_email"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_normal"
                android:layout_marginTop="@dimen/spacing_tiny"
                android:text="myName@gmail.com"
                android:textColor="@color/modal_text_light_red"
                android:textSize="13sp"
                app:layout_constraintTop_toBottomOf="@id/text_profile_name"
                app:layout_constraintBottom_toBottomOf="@id/avatar_container"
                app:layout_constraintStart_toEndOf="@id/avatar_container"
                app:layout_constraintEnd_toStartOf="@id/text_profile_tag" />

            <TextView
                android:id="@+id/text_profile_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/modal_status_chip_bg"
                android:paddingLeft="8dp"
                android:paddingTop="4dp"
                android:paddingRight="8dp"
                android:paddingBottom="4dp"
                android:text="⚡ ACTIVE"
                android:textColor="@color/modal_chip_success_text"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="@id/avatar_container"
                app:layout_constraintBottom_toBottomOf="@id/avatar_container"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Friend Code Section - Compact Design -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/friend_code_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:background="@color/modal_friend_code_bg"
                android:paddingStart="@dimen/spacing_normal"
                android:paddingTop="@dimen/spacing_small"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingBottom="@dimen/spacing_small"
                app:layout_constraintTop_toBottomOf="@id/avatar_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/label_friend_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_friend_code_label"
                    android:textColor="@color/modal_text_on_accent"
                    android:textSize="11sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/text_profile_friend_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:text="----·----"
                    android:textColor="@color/modal_text_primary"
                    android:textIsSelectable="true"
                    android:textSize="22sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/label_friend_code"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <Button
                    android:id="@+id/btn_copy_friend_code"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="📋 COPY"
                    android:textColor="@color/modal_text_primary"
                    android:textSize="12sp"
                    app:layout_constraintTop_toTopOf="@id/text_profile_friend_code"
                    app:layout_constraintBottom_toBottomOf="@id/text_profile_friend_code"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Divider Line -->
            <View
                android:id="@+id/divider1"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="@dimen/section_spacing"
                android:layout_marginBottom="@dimen/section_spacing"
                android:background="@color/modal_divider_solid"
                app:layout_constraintTop_toBottomOf="@id/friend_code_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Player Statistics Section -->
            <TextView
                android:id="@+id/label_statistics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="Player Statistics"
                android:textColor="@color/modal_text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/divider1"
                app:layout_constraintStart_toStartOf="parent" />

            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_upgrade_item"
                android:orientation="vertical"
                android:padding="@dimen/stats_card_padding"
                app:layout_constraintTop_toBottomOf="@id/label_statistics"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/text_profile_energy_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total generated: --"
                    android:textColor="@color/modal_text_on_light"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_profile_energy_per_second"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stats_item_spacing"
                    android:text="Production: --"
                    android:textColor="@color/modal_text_on_light"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_profile_generators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stats_item_spacing"
                    android:text="Generators: --"
                    android:textColor="@color/modal_text_on_light"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_profile_offline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stats_item_spacing"
                    android:text="Offline: --"
                    android:textColor="@color/modal_text_on_light"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_profile_last_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stats_item_spacing"
                    android:text="Last sync: --"
                    android:textColor="@color/modal_text_on_light"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <Button
                android:id="@+id/btn_profile_edit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:paddingTop="@dimen/button_padding_vertical"
                android:paddingBottom="@dimen/button_padding_vertical"
                android:text="EDIT PROFILE"
                android:textColor="@color/modal_text_primary"
                app:strokeColor="@color/modal_text_primary"
                app:layout_constraintTop_toBottomOf="@id/stats_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_profile_settings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:paddingTop="@dimen/button_padding_vertical"
                android:paddingBottom="@dimen/button_padding_vertical"
                android:text="SETTINGS"
                android:textColor="@color/modal_text_primary"
                app:strokeColor="@color/modal_text_primary"
                app:layout_constraintTop_toBottomOf="@id/btn_profile_edit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_profile_friends"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:paddingTop="@dimen/button_padding_vertical"
                android:paddingBottom="@dimen/button_padding_vertical"
                android:text="FRIENDS"
                android:textColor="@color/modal_text_primary"
                app:strokeColor="@color/modal_text_primary"
                app:layout_constraintTop_toBottomOf="@id/btn_profile_settings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_profile_debug_notifications"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_small"
                android:paddingTop="@dimen/button_padding_vertical"
                android:paddingBottom="@dimen/button_padding_vertical"
                android:text="🔔 DEBUG NOTIFICATIONS"
                android:textColor="@color/modal_button_accent"
                app:strokeColor="@color/modal_button_accent"
                app:layout_constraintTop_toBottomOf="@id/btn_profile_friends"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_profile_logout"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:backgroundTint="@color/modal_background_red"
                android:paddingTop="@dimen/button_padding_vertical"
                android:paddingBottom="@dimen/button_padding_vertical"
                android:text="LOGOUT"
                android:textColor="@color/modal_text_primary"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btn_profile_debug_notifications" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Tabs Section (Overlapping at top) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabs_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tab_profile_selected"
            android:drawableStart="@drawable/ic_profile_white"
            android:drawablePadding="@dimen/modal_tab_drawable_padding"
            android:gravity="center"
            android:paddingTop="@dimen/modal_tab_padding_vertical"
            android:paddingBottom="@dimen/modal_tab_padding_vertical"
            android:text="Profile"
            android:textColor="@color/modal_text_primary"
            android:textSize="@dimen/modal_tab_text_size"
            android:textStyle="bold"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tab_spacer" />

        <Space
            android:id="@+id/tab_spacer"
            android:layout_width="@dimen/modal_tab_spacer_width"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tab_profile"
            app:layout_constraintEnd_toStartOf="@id/tab_leaderboard" />

        <TextView
            android:id="@+id/tab_leaderboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tab_leaderboard"
            android:drawableStart="@drawable/ic_leaderboard_white"
            android:drawablePadding="@dimen/modal_tab_drawable_padding"
            android:gravity="center"
            android:paddingTop="@dimen/modal_tab_padding_vertical"
            android:paddingBottom="@dimen/modal_tab_padding_vertical"
            android:text="Leader board"
            android:textColor="@color/modal_text_primary"
            android:textSize="@dimen/modal_tab_text_size"
            android:elevation="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tab_spacer"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Close Button overlaying tabs -->
    <include layout="@layout/include_modal_close_button" />
</androidx.constraintlayout.widget.ConstraintLayout>
