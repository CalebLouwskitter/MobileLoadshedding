<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_spacing"
    android:background="@drawable/bg_leaderboard_row"
    android:padding="@dimen/item_padding"
    android:animateLayoutChanges="true">

    <TextView
        android:id="@+id/text_rank"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="#1"
        android:textColor="#212121"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/text_entry_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:text="Player Name"
        android:textColor="#0E3D57"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/text_rank"
        app:layout_constraintEnd_toStartOf="@id/image_entry_status"
        app:layout_constraintBottom_toTopOf="@id/text_entry_detail" />

    <TextView
        android:id="@+id/text_entry_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginTop="@dimen/spacing_tiny"
        android:text="R 120 343"
        android:textColor="#0E3D57"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/text_entry_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/text_rank"
        app:layout_constraintEnd_toStartOf="@id/image_entry_status" />

    <ImageView
        android:id="@+id/image_entry_status"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="@dimen/spacing_small"
        android:contentDescription="Rank icon"
        android:src="@android:drawable/btn_star_big_on"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
