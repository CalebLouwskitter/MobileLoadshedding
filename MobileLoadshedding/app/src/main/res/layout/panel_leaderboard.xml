<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Spacer for tabs -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <!-- Main Panel -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_leaderboard_panel"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/panel_padding_horizontal"
                    android:paddingTop="@dimen/panel_padding_top"
                    android:paddingEnd="@dimen/panel_padding_horizontal"
                    android:paddingBottom="@dimen/panel_padding_vertical">

                    <!-- Friends/Global Toggle Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:layout_marginBottom="@dimen/spacing_normal"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_tab_friends"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_small"
                            android:layout_weight="1"
                            android:background="@drawable/bg_toggle_friends"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:paddingTop="@dimen/spacing_medium"
                            android:paddingBottom="@dimen/spacing_medium"
                            android:text="Friends"
                            android:textColor="#000000"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_tab_global"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/spacing_small"
                            android:layout_weight="1"
                            android:background="@drawable/bg_toggle_global"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:paddingTop="@dimen/spacing_medium"
                            android:paddingBottom="@dimen/spacing_medium"
                            android:text="Global"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/text_leaderboard_last_updated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:text="Updated --"
                        android:textColor="#424242"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:id="@+id/leaderboard_loading"
                        style="@android:style/Widget.ProgressBar.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_large"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/text_leaderboard_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/spacing_xlarge"
                        android:text="No leaderboard entries yet"
                        android:textColor="#757575"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/leaderboard_list_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:animateLayoutChanges="true"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tabs Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tab_profile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/tab_profile"
                    android:drawableStart="@drawable/ic_profile_white"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="Profile"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="6dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/tab_leaderboard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/tab_leaderboard_selected"
                    android:drawableStart="@drawable/ic_leaderboard_white"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="Leader board"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Close Button -->
            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-8dp"
                android:layout_marginEnd="-8dp"
                android:background="@drawable/circle_red"
                android:elevation="10dp" />

            <ImageButton
                android:id="@+id/close_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-8dp"
                android:layout_marginEnd="-8dp"
                android:background="@android:color/transparent"
                android:contentDescription="Close"
                android:elevation="10dp"
                android:src="@drawable/ic_close_white"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
