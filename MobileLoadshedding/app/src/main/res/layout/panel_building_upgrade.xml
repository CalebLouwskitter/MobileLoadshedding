<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabs_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tab_electricity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tab_electricity"
            android:drawableStart="@drawable/ic_lightning_white"
            android:drawablePadding="@dimen/modal_tab_drawable_padding"
            android:elevation="2dp"
            android:gravity="center"
            android:paddingTop="@dimen/modal_tab_padding_vertical"
            android:paddingBottom="@dimen/modal_tab_padding_vertical"
            android:text="Electricity"
            android:textColor="@color/modal_text_primary"
            android:textSize="@dimen/modal_tab_text_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tab_spacer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Space
            android:id="@+id/tab_spacer"
            android:layout_width="@dimen/modal_tab_spacer_width"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tab_building"
            app:layout_constraintStart_toEndOf="@id/tab_electricity"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tab_building"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tab_building_selected"
            android:drawableStart="@drawable/ic_building_white"
            android:drawablePadding="@dimen/modal_tab_drawable_padding"
            android:elevation="4dp"
            android:gravity="center"
            android:paddingTop="@dimen/modal_tab_padding_vertical"
            android:paddingBottom="@dimen/modal_tab_padding_vertical"
            android:text="Building"
            android:textColor="@color/modal_text_primary"
            android:textSize="@dimen/modal_tab_text_size"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tab_spacer"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Tabs Section (Overlapping at top) -->

    <!-- Close Button overlaying Building tab -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:layout_marginBottom="16dp"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_pink"
            android:paddingStart="@dimen/panel_padding_horizontal"
            android:paddingTop="@dimen/panel_padding_top"
            android:paddingEnd="@dimen/panel_padding_horizontal"
            android:paddingBottom="@dimen/panel_padding_vertical">

            <LinearLayout
                android:id="@+id/list_building_upgrades"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:paddingStart="@dimen/panel_content_padding"
                android:paddingTop="@dimen/panel_content_padding"
                android:paddingEnd="@dimen/panel_content_padding"
                android:paddingBottom="@dimen/panel_content_padding"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0">

                <include layout="@layout/view_upgrade_item" />

                <include
                    layout="@layout/view_upgrade_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing" />

                <include
                    layout="@layout/view_upgrade_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing" />

                <include
                    layout="@layout/view_upgrade_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing" />

                <include
                    layout="@layout/view_upgrade_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
