<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_pink"
            android:paddingStart="@dimen/panel_padding_horizontal"
            android:paddingTop="@dimen/panel_padding_top"
            android:paddingEnd="@dimen/panel_padding_horizontal"
            android:paddingBottom="@dimen/panel_padding_vertical">

            <LinearLayout
                android:id="@+id/list_building_upgrades"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:paddingStart="@dimen/panel_content_padding"
                android:paddingTop="@dimen/panel_content_padding"
                android:paddingEnd="@dimen/panel_content_padding"
                android:paddingBottom="@dimen/panel_content_padding"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <include layout="@layout/view_upgrade_item" />

                <include
                    layout="@layout/view_upgrade_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing" />

                <include
                    layout="@layout/view_upgrade_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing" />

                <include
                    layout="@layout/view_upgrade_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing" />

                <include
                    layout="@layout/view_upgrade_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_spacing" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Tabs Section (Overlapping at top) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabs_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tab_electricity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tab_electricity"
            android:drawableStart="@drawable/ic_lightning_white"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Electricity"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tab_spacer" />

        <Space
            android:id="@+id/tab_spacer"
            android:layout_width="6dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tab_electricity"
            app:layout_constraintEnd_toStartOf="@id/tab_building" />

        <TextView
            android:id="@+id/tab_building"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tab_building_selected"
            android:drawableStart="@drawable/ic_building_white"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Building"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tab_spacer"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Close Button overlaying Building tab -->
    <View
        android:id="@+id/close_button_bg"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="-8dp"
        android:background="@drawable/circle_red"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/close_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="-8dp"
        android:background="@android:color/transparent"
        android:contentDescription="Close"
        android:elevation="10dp"
        android:src="@drawable/ic_close_white"
        app:tint="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
