<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="16dp">

    <!-- Top HUD -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_hud"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hud"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btn_hud_upgrades"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_icon"
            android:contentDescription="Upgrades"
            android:padding="8dp"
            android:src="@drawable/ic_hud_lightning"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/currency_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_hud_upgrades"
            app:layout_constraintEnd_toStartOf="@id/btn_hud_profile">

            <TextView
                android:id="@+id/text_currency_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1,978.12"
                android:textColor="#052E45"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_energy_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Energy Credits"
                android:textColor="#052E45"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_energy_per_second"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+0.00 /s"
                android:textColor="#052E45"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_active_generators"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 generators"
                android:textColor="#052E45"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_safe_idle_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Safe idle: --"
                android:textColor="#052E45"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_hud_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hud_icon"
            android:contentDescription="Profile"
            android:padding="8dp"
            android:src="@drawable/ic_hud_profile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/text_event_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#260E3D57"
        android:padding="8dp"
        android:text="No active grid events"
        android:textColor="#052E45"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/top_hud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Navigation -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btn_nav_level_up"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="Level Ups"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_nav_power" />

        <Button
            android:id="@+id/btn_nav_power"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:backgroundTint="#FFEB3B"
            android:text="Power"
            android:textColor="#052E45"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_nav_level_up"
            app:layout_constraintEnd_toStartOf="@id/btn_nav_tasks" />

        <Button
            android:id="@+id/btn_nav_tasks"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Tasks"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/btn_nav_power"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/hud_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/text_event_status"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Modal Scrim (semi-transparent overlay) -->
    <View
        android:id="@+id/modal_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Modal Container for panels -->
    <FrameLayout
        android:id="@+id/modal_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
