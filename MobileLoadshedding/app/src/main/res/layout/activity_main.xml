<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/hud_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="fill">

        <LinearLayout
            android:id="@+id/top_hud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_hud"
            android:padding="12dp">

            <ImageButton
                android:id="@+id/btn_hud_upgrades"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hud_icon"
                android:contentDescription="@string/hud_upgrades_content_description"
                android:padding="8dp"
                android:src="@drawable/ic_hud_lightning" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_currency_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1,978.12"
                    android:textColor="#052E45"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_energy_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hud_energy_label"
                    android:textColor="#052E45"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_energy_per_second"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+0.00 /s"
                    android:textColor="#052E45"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_active_generators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 generators"
                    android:textColor="#052E45"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/text_safe_idle_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Safe idle: --"
                    android:textColor="#052E45"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_hud_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hud_icon"
                android:contentDescription="@string/hud_profile_content_description"
                android:padding="8dp"
                android:src="@drawable/ic_hud_profile" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_event_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#260E3D57"
            android:padding="8dp"
            android:text="@string/hud_event_inactive"
            android:textColor="#052E45"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="end|bottom"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_advert_upgrade"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="248dp"
                android:layout_height="41dp"
                android:layout_gravity="center_horizontal"
                android:text="@string/advert_upgrade_text" />

            <LinearLayout
                android:id="@+id/bottom_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="12dp">

                <Button
                    android:id="@+id/btn_nav_level_up"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/nav_level_up" />

                <Button
                    android:id="@+id/btn_nav_power"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FFEB3B"
                    android:text="@string/nav_power"
                    android:textColor="#052E45"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_nav_tasks"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/nav_tasks" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/modal_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/modal_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:visibility="gone" />

</FrameLayout>
