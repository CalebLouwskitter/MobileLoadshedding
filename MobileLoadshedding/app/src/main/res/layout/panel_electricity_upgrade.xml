<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/modal_tab_overlap_height"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_blue"
            android:paddingStart="@dimen/panel_padding_horizontal"
            android:paddingTop="@dimen/panel_padding_top"
            android:paddingEnd="@dimen/panel_padding_horizontal"
            android:paddingBottom="@dimen/panel_padding_vertical">

            <TextView
                android:id="@+id/text_production_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/panel_content_padding"
                android:text="Grid Production"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_current_energy_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_normal"
                android:text="Current energy: --"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/text_production_title"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_current_production_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Production: --"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/text_current_energy_value"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_generators_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Generators: --"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/text_current_production_value"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_currency_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Energy credits: --"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/text_generators_value"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_offline_time_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Offline progress: --"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/text_currency_value"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_safe_idle_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Safe idle: --"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/text_offline_time_value"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_core_charge_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Core charge: --"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/text_safe_idle_value"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_last_event_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Last event: --"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/text_core_charge_value"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_last_save_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_small"
                android:text="Last save sync: --"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                app:layout_constraintTop_toBottomOf="@id/text_last_event_value"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/text_districts_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_xlarge"
                android:layout_marginEnd="@dimen/panel_content_padding"
                android:text="District Overview"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/text_last_save_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/list_districts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_normal"
                android:layout_marginEnd="@dimen/panel_content_padding"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/text_districts_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btn_refresh_production"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/panel_content_padding"
                android:layout_marginTop="@dimen/spacing_normal"
                android:layout_marginBottom="@dimen/panel_content_padding"
                android:paddingStart="@dimen/button_padding_horizontal"
                android:paddingTop="@dimen/button_padding_vertical"
                android:paddingEnd="@dimen/button_padding_horizontal"
                android:paddingBottom="@dimen/button_padding_vertical"
                android:text="REFRESH"
                android:textColor="#FFFFFF"
                app:strokeColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/list_districts"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Tabs Section (Overlapping at top) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabs_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tab_electricity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tab_electricity_selected"
            android:drawableStart="@drawable/ic_lightning_white"
            android:drawablePadding="@dimen/modal_tab_drawable_padding"
            android:gravity="center"
            android:paddingTop="@dimen/modal_tab_padding_vertical"
            android:paddingBottom="@dimen/modal_tab_padding_vertical"
            android:text="Electricity"
            android:textColor="@color/modal_text_primary"
            android:textSize="@dimen/modal_tab_text_size"
            android:textStyle="bold"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tab_spacer" />

        <Space
            android:id="@+id/tab_spacer"
            android:layout_width="@dimen/modal_tab_spacer_width"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/tab_electricity"
            app:layout_constraintEnd_toStartOf="@id/tab_building" />

        <TextView
            android:id="@+id/tab_building"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/tab_building"
            android:drawableStart="@drawable/ic_building_white"
            android:drawablePadding="@dimen/modal_tab_drawable_padding"
            android:gravity="center"
            android:paddingTop="@dimen/modal_tab_padding_vertical"
            android:paddingBottom="@dimen/modal_tab_padding_vertical"
            android:text="Building"
            android:textColor="@color/modal_text_primary"
            android:textSize="@dimen/modal_tab_text_size"
            android:elevation="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tab_spacer"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Close Button overlaying tabs -->
    <include layout="@layout/include_modal_close_button" />
</androidx.constraintlayout.widget.ConstraintLayout>
