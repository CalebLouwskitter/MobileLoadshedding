<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_medium"
    android:background="@drawable/bg_panel_rounded"
    android:orientation="vertical"
    android:padding="@dimen/spacing_normal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_district_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="District"
            android:textColor="#0E3D57"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_district_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Level 1"
            android:textColor="#0E3D57"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_district_output"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="0 /s"
        android:textColor="#0E3D57"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/text_district_efficiency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_small"
        android:text="100% efficiency"
        android:textColor="#4A6572"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/text_district_idle_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Safe idle: --"
        android:textColor="#4A6572"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_normal"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_district_service"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/button_padding_horizontal"
            android:paddingTop="@dimen/button_padding_vertical"
            android:paddingEnd="@dimen/button_padding_horizontal"
            android:paddingBottom="@dimen/button_padding_vertical"
            android:text="SERVICE" />

        <Button
            android:id="@+id/btn_district_upgrade"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:paddingStart="@dimen/button_padding_horizontal"
            android:paddingTop="@dimen/button_padding_vertical"
            android:paddingEnd="@dimen/button_padding_horizontal"
            android:paddingBottom="@dimen/button_padding_vertical"
            android:text="UPGRADE" />
    </LinearLayout>

</LinearLayout>
