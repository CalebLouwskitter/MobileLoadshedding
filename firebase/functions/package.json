{
  "name": "mobileloadshedding-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for MobileLoadshedding demo notifications",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "deploy": "firebase deploy --only functions",
    "deploy:single": "firebase deploy --only functions:triggerNotification",
    "deploy:events": "firebase deploy --only functions:sendEventStarted,functions:sendEventEndingSoon",
    "deploy:friends": "firebase deploy --only functions:sendFriendRequest,functions:sendFriendAccepted",
    "deploy:system": "firebase deploy --only functions:sendMaintenanceNotification,functions:sendSystemAnnouncement,functions:sendGeneralNotification",
    "deploy:game": "firebase deploy --only functions:sendLeaderboardUpdate,functions:sendEnergyMilestone,functions:sendOfflineEarningsReady",
    "serve": "firebase emulators:start --only functions",
    "test": "node test-notifications.js",
    "lint": "npx eslint . || echo 'Add ESLint if desired'"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.1"
  }
}
