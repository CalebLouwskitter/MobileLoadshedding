/* IdleLoadshedding HUD. Portrait, reference width 1080. State is always shown with text or an
   icon as well as colour. */

.hud-root {
    flex-grow: 1;
    font-size: 30px;
    color: rgb(236, 240, 246);
}

.layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.safe {
    flex-direction: column;
}

.top-bar {
    flex-direction: row;
    flex-wrap: wrap;
    background-color: rgba(9, 16, 28, 0.88);
    padding: 12px 16px;
    border-bottom-width: 2px;
    border-bottom-color: rgb(40, 56, 82);
}

.stat {
    flex-grow: 1;
    flex-basis: 25%;
    padding: 4px 8px;
}

.stat-label {
    font-size: 22px;
    color: rgb(150, 166, 190);
}

.stat-value {
    font-size: 32px;
    -unity-font-style: bold;
}

.phase-chip {
    align-self: flex-start;
    margin: 10px 16px;
    padding: 6px 16px;
    border-radius: 24px;
    font-size: 24px;
    -unity-font-style: bold;
    background-color: rgb(34, 92, 66);
}

.phase-chip--alert {
    background-color: rgb(168, 72, 28);
}

.spacer {
    flex-grow: 1;
    min-height: 120px;
}

.sheet {
    max-height: 58%;
    background-color: rgba(12, 20, 34, 0.96);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    padding: 12px 16px 24px 16px;
}

.card {
    background-color: rgb(24, 36, 56);
    border-radius: 20px;
    padding: 20px;
    margin-bottom: 16px;
}

.title {
    font-size: 36px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    white-space: normal;
}

.headline {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 214, 120);
    margin: 6px 0;
    white-space: normal;
}

.body {
    white-space: normal;
    margin: 4px 0;
    flex-shrink: 1;
}

.muted {
    white-space: normal;
    font-size: 25px;
    color: rgb(160, 174, 196);
    margin: 2px 0;
}

.tag {
    align-self: flex-start;
    font-size: 22px;
    -unity-font-style: bold;
    padding: 4px 12px;
    margin: 0 8px 6px 0;
    border-radius: 12px;
    background-color: rgb(46, 66, 98);
}

.row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.grow {
    flex-grow: 1;
}

.btn {
    min-height: 88px;
    margin: 8px 8px 0 0;
    padding: 8px 20px;
    border-radius: 16px;
    border-width: 0;
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(236, 240, 246);
    background-color: rgb(52, 74, 108);
    white-space: normal;
}

.btn-primary {
    background-color: rgb(28, 120, 220);
}

.btn-secondary {
    background-color: rgb(52, 74, 108);
}

.btn-small {
    min-height: 72px;
    min-width: 96px;
    font-size: 24px;
    padding: 4px 12px;
}

.btn-wide {
    margin-right: 0;
    margin-top: 12px;
}

.btn:disabled {
    opacity: 0.45;
}

.plan-card {
    flex-direction: column;
    align-items: stretch;
    -unity-text-align: upper-left;
    min-height: 0;
    margin: 8px 0 0 0;
    padding: 16px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgb(32, 48, 72);
}

.plan-card--selected {
    border-color: rgb(255, 214, 120);
    background-color: rgb(40, 60, 92);
}

.plan-title {
    font-size: 30px;
    -unity-font-style: bold;
    white-space: normal;
}

.preview {
    margin-top: 16px;
    padding: 12px;
    border-radius: 14px;
    background-color: rgb(16, 26, 42);
}

.grid-head {
    width: 30%;
    font-size: 24px;
    color: rgb(150, 166, 190);
}

.grid-name {
    width: 30%;
}

.grid-cell {
    width: 30%;
    font-size: 26px;
}

.pill {
    width: 30%;
    margin: 4px 8px 4px 0;
    padding: 4px 8px;
    border-radius: 12px;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.pill--on {
    background-color: rgb(40, 140, 80);
}

.pill--off {
    background-color: rgb(120, 40, 40);
}

.pill--part {
    background-color: rgb(150, 110, 30);
}

.priority-row {
    padding: 6px 0;
    border-top-width: 1px;
    border-top-color: rgb(40, 56, 82);
}

.progress {
    height: 24px;
    border-radius: 12px;
    background-color: rgb(16, 26, 42);
    margin: 8px 0;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    width: 0;
    background-color: rgb(255, 196, 80);
}

.bulb {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    margin-right: 12px;
    border-width: 4px;
}

.bulb--on {
    background-color: rgb(255, 210, 100);
    border-color: rgb(255, 236, 170);
}

.bulb--off {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgb(110, 120, 138);
}

.shop-item {
    padding: 12px 0;
    border-top-width: 1px;
    border-top-color: rgb(40, 56, 82);
}

.modal-layer {
    background-color: rgba(0, 0, 0, 0.6);
    justify-content: center;
    padding: 40px 32px;
}

.modal {
    border-width: 2px;
    border-color: rgb(70, 96, 136);
}

.toast {
    position: absolute;
    left: 10%;
    right: 10%;
    top: 22%;
    padding: 16px 24px;
    border-radius: 20px;
    background-color: rgba(20, 30, 46, 0.95);
    border-width: 2px;
    border-color: rgb(255, 214, 120);
    -unity-text-align: middle-center;
    white-space: normal;
}

.world-label {
    position: absolute;
    width: 220px;
    padding: 8px 10px;
    border-radius: 14px;
    background-color: rgba(10, 18, 30, 0.82);
    border-width: 2px;
    border-color: rgb(255, 210, 100);
}

.world-label--dark {
    border-color: rgb(110, 120, 138);
}

.world-title {
    font-size: 26px;
    -unity-font-style: bold;
}

.world-status {
    font-size: 22px;
    -unity-font-style: bold;
}

.world-detail {
    font-size: 18px;
    color: rgb(170, 182, 200);
    white-space: normal;
}
