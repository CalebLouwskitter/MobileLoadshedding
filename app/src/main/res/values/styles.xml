<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.Auth.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/auth_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">12dp</item>
        <item name="android:insetBottom">12dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.Auth.SecondaryButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/auth_google_border</item>
        <item name="android:textColor">@color/auth_google_text</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:insetTop">12dp</item>
        <item name="android:insetBottom">12dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>

    <style name="Widget.Auth.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/auth_outline</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="android:textColorHint">@color/auth_hint</item>
        <item name="hintTextColor">@color/auth_hint</item>
        <item name="shapeAppearance">@style/Shape.Auth.TextField</item>
    </style>

    <style name="Shape.Auth.TextField" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="TextAppearance.Auth.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/auth_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Auth.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/auth_body</item>
    </style>

    <style name="TextAppearance.Auth.HeaderTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/auth_header_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Auth.HeaderSubtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/auth_subtitle_text</item>
    </style>

</resources>
