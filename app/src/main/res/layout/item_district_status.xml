<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_district_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#0E3D57"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="District" />

        <TextView
            android:id="@+id/text_district_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#0E3D57"
            android:textSize="14sp"
            android:text="Level 1" />
    </LinearLayout>

    <TextView
        android:id="@+id/text_district_output"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0 /s"
        android:textColor="#0E3D57"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/text_district_efficiency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="100% efficiency"
        android:textColor="#4A6572"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/text_district_idle_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Safe idle: --"
        android:textColor="#4A6572"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_district_service"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Service" />

        <Button
            android:id="@+id/btn_district_upgrade"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Upgrade" />
    </LinearLayout>

</LinearLayout>
