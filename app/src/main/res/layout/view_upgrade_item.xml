<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_upgrade_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/item_padding">

    <!-- Left side: Name, Level, Output -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_upgrade_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generator 1"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_upgrade_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:text="Level: 1"
            android:textColor="#666666"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/text_upgrade_output"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_tiny"
            android:text=""
            android:textColor="#666666"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Right side: Upgrade Button -->
    <Button
        android:id="@+id/btn_upgrade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:background="@drawable/bg_upgrade_button"
        android:minWidth="@dimen/button_min_width"
        android:paddingStart="@dimen/button_padding_horizontal"
        android:paddingTop="@dimen/button_padding_vertical"
        android:paddingEnd="@dimen/button_padding_horizontal"
        android:paddingBottom="@dimen/button_padding_vertical"
        android:text="Tap to Upgrade"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
