<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Spacer for tabs -->
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- Main Pink Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_pink"
                android:orientation="vertical"
                android:paddingStart="@dimen/panel_padding_horizontal"
                android:paddingTop="@dimen/panel_padding_top"
                android:paddingEnd="@dimen/panel_padding_horizontal"
                android:paddingBottom="@dimen/panel_padding_vertical">

                <!-- Upgrade Items Container -->
                <LinearLayout
                    android:id="@+id/list_building_upgrades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/panel_content_padding"
                    android:paddingTop="@dimen/panel_content_padding"
                    android:paddingEnd="@dimen/panel_content_padding"
                    android:paddingBottom="@dimen/panel_content_padding">

                    <include layout="@layout/view_upgrade_item" />

                    <include
                        layout="@layout/view_upgrade_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_spacing" />

                    <include
                        layout="@layout/view_upgrade_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_spacing" />

                    <include
                        layout="@layout/view_upgrade_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_spacing" />

                    <include
                        layout="@layout/view_upgrade_item"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_spacing" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tabs Section (Overlapping) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_electricity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tab_electricity"
                android:drawableStart="@drawable/ic_lightning_white"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Electricity"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tab_building"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tab_building_selected"
                android:drawableStart="@drawable/ic_building_white"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Building"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Close Button overlaying Building tab -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-8dp"
            android:background="@drawable/circle_red"
            android:elevation="10dp" />

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-8dp"
            android:background="@android:color/transparent"
            android:contentDescription="Close"
            android:elevation="10dp"
            android:src="@drawable/ic_close_white"
            app:tint="#FFFFFF" />
    </FrameLayout>
</FrameLayout>
