<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">

        <!-- Spacer for tabs -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- Main Red Panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel_red"
            android:orientation="vertical"
            android:paddingStart="@dimen/panel_padding_horizontal"
            android:paddingTop="@dimen/panel_padding_top"
            android:paddingEnd="@dimen/panel_padding_horizontal"
            android:paddingBottom="@dimen/panel_padding_vertical">

            <!-- Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="@dimen/spacing_medium">

                <!-- Avatar -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp">

                    <View
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/circle_white" />

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="Profile Avatar"
                        android:src="@drawable/ic_profile_large"
                        app:tint="#8B0000" />
                </FrameLayout>

                <!-- Name and Email -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_normal"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Name"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_profile_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_tiny"
                        android:text="myName@gmail.com"
                        android:textColor="#FFCDD2"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_profile_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FFC107"
                    android:paddingLeft="8dp"
                    android:paddingTop="4dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="4dp"
                    android:text="⚡ ACTIVE"
                    android:textColor="#212121"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Friend Code Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_normal"
                android:background="#E53935"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Friend Code"
                    android:textColor="#FFEBEE"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_profile_friend_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="Loading..."
                        android:textColor="#FFFFFF"
                        android:textIsSelectable="true"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_copy_friend_code"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="8dp"
                        android:text="COPY"
                        android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider Line -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="@dimen/section_spacing"
                android:layout_marginBottom="@dimen/section_spacing"
                android:background="#FFFFFF" />

            <!-- Player Statistics Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Player Statistics"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_medium"
                android:background="@drawable/bg_upgrade_item"
                android:orientation="vertical"
                android:padding="@dimen/stats_card_padding">

                <TextView
                    android:id="@+id/text_profile_energy_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total generated: --"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_profile_energy_per_second"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stats_item_spacing"
                    android:text="Production: --"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_profile_generators"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stats_item_spacing"
                    android:text="Generators: --"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_profile_offline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stats_item_spacing"
                    android:text="Offline: --"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/text_profile_last_sync"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/stats_item_spacing"
                    android:text="Last sync: --"
                    android:textColor="#000000"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_large"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_profile_edit"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="@dimen/button_padding_vertical"
                    android:paddingBottom="@dimen/button_padding_vertical"
                    android:text="EDIT PROFILE"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_profile_settings"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:paddingTop="@dimen/button_padding_vertical"
                    android:paddingBottom="@dimen/button_padding_vertical"
                    android:text="SETTINGS"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_profile_friends"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:paddingTop="@dimen/button_padding_vertical"
                    android:paddingBottom="@dimen/button_padding_vertical"
                    android:text="FRIENDS"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_profile_details"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_small"
                    android:paddingTop="@dimen/button_padding_vertical"
                    android:paddingBottom="@dimen/button_padding_vertical"
                    android:text="VIEW DETAILS"
                    android:textColor="#FFFFFF"
                    app:strokeColor="#FFFFFF" />

                <Button
                    android:id="@+id/btn_profile_logout"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_normal"
                    android:backgroundTint="#D32F2F"
                    android:paddingTop="@dimen/button_padding_vertical"
                    android:paddingBottom="@dimen/button_padding_vertical"
                    android:text="LOGOUT"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Tabs Section (Overlapping) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_profile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_profile_selected"
            android:drawableStart="@drawable/ic_profile_white"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Profile"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="6dp"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tab_leaderboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/tab_leaderboard"
            android:drawableStart="@drawable/ic_leaderboard_white"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Leader board"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Close Button -->
    <View
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="-8dp"
        android:background="@drawable/circle_red"
        android:elevation="10dp" />

    <ImageButton
        android:id="@+id/close_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="-8dp"
        android:background="@android:color/transparent"
        android:contentDescription="Close"
        android:elevation="10dp"
        android:src="@drawable/ic_close_white"
        app:tint="#FFFFFF" />
</FrameLayout>
