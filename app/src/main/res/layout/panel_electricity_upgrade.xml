<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Spacer for tabs -->
            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

            <!-- Main Blue Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel_blue"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="25dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <!-- Content Container -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/text_production_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Grid Production"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_current_energy_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Current energy: --"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/text_current_production_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Production: --"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/text_generators_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Generators: --"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/text_currency_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Energy credits: --"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/text_offline_time_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Offline progress: --"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/text_safe_idle_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Safe idle: --"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/text_core_charge_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Core charge: --"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/text_last_event_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Last event: --"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/text_last_save_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Last save sync: --"
                        android:textColor="#FFFFFF" />

                    <TextView
                        android:id="@+id/text_districts_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="District Overview"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/list_districts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                    <Button
                        android:id="@+id/btn_refresh_production"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Refresh"
                        android:textColor="#FFFFFF"
                        app:strokeColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tabs Section (Overlapping) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_electricity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tab_electricity_selected"
                android:drawableStart="@drawable/ic_lightning_white"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Electricity"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tab_building"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tab_building"
                android:drawableStart="@drawable/ic_building_white"
                android:drawablePadding="8dp"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Building"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Close Button overlaying -->
        <View
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-8dp"
            android:background="@drawable/circle_red"
            android:elevation="10dp" />

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-8dp"
            android:background="@android:color/transparent"
            android:contentDescription="Close"
            android:elevation="10dp"
            android:src="@drawable/ic_close_white"
            app:tint="#FFFFFF" />
    </FrameLayout>
</FrameLayout>
