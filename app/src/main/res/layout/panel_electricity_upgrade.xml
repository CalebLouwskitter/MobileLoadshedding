<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel_rounded"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_electricity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#0E3D57"
            android:padding="12dp"
            android:text="Electricity"
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tab_building"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#E91E63"
            android:padding="12dp"
            android:text="Building"
            android:textAlignment="center"
            android:textColor="#FFFFFF" />

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_production_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grid Production"
            android:textAllCaps="false"
            android:textColor="#0E3D57"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_current_energy_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Current energy: --"
            android:textColor="#0E3D57" />

        <TextView
            android:id="@+id/text_current_production_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Production: --"
            android:textColor="#0E3D57" />

        <TextView
            android:id="@+id/text_generators_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Generators: --"
            android:textColor="#0E3D57" />

        <TextView
            android:id="@+id/text_currency_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Energy credits: --"
            android:textColor="#0E3D57" />

        <TextView
            android:id="@+id/text_offline_time_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Offline progress: --"
            android:textColor="#0E3D57" />

        <TextView
            android:id="@+id/text_safe_idle_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Safe idle: --"
            android:textColor="#0E3D57" />

        <TextView
            android:id="@+id/text_core_charge_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Core charge: --"
            android:textColor="#0E3D57" />

        <TextView
            android:id="@+id/text_last_event_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Last event: --"
            android:textColor="#0E3D57" />

        <TextView
            android:id="@+id/text_last_save_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Last save sync: --"
            android:textColor="#0E3D57" />

        <TextView
            android:id="@+id/text_districts_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="District Overview"
            android:textColor="#0E3D57"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/list_districts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btn_refresh_production"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Refresh" />
    </LinearLayout>
</LinearLayout>
