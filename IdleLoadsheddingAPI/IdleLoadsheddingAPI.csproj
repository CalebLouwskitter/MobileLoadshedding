<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- (Microsoft, 2025) - Target .NET 9.0 framework -->
    <TargetFramework>net9.0</TargetFramework>
    <!-- (Microsoft, 2025) - Enable C# nullable reference types -->
    <Nullable>enable</Nullable>
    <!-- (Microsoft, 2025) - Enable implicit using directives -->
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- (Microsoft, 2025) - JWT Bearer authentication for Firebase tokens -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    
    <!-- (Microsoft, 2025) - In-memory database provider for testing -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.9" />
    
    <!-- (Microsoft, 2025) - SQL Server database provider -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.9" />
    
    <!-- (Microsoft, 2025) - EF Core tools for migrations -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
